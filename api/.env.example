# Deixe vazio para usar o PGlite local (Postgres embutido, sem instalar nada).
# Em produção: a connection string do Neon, com ?sslmode=require.
DATABASE_URL=

# Obrigatório em produção. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Endereço do front publicado, separado por vírgula se houver mais de um.
CORS_ORIGIN=http://localhost:5173

PORT=3333

# Assistente do chat. Sem chave, ele roda no "modo simples" (regras, sem IA).
# Crie a chave em https://platform.claude.com (Settings, API keys).
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
# Limites de uso para não ter surpresa na conta da API
ASSISTANT_HOURLY_LIMIT=60
ASSISTANT_DEMO_LIMIT=15
ASSISTANT_DEMO_DAILY_LIMIT=300
APP_TIMEZONE=America/Sao_Paulo
