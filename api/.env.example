# Deixe vazio para usar o PGlite local (Postgres embutido, sem instalar nada).
# Em produção: a connection string do Neon, com ?sslmode=require.
DATABASE_URL=

# Obrigatório em produção. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Endereço do front publicado, separado por vírgula se houver mais de um.
CORS_ORIGIN=http://localhost:5173

PORT=3333

# Assistente do chat: cada usuário conecta a própria IA (Claude, ChatGPT ou Gemini) em Ajustes.
# As chaves ficam criptografadas no banco com este segredo (32 bytes em hex). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Guarde-o: se mudar, os usuários precisam conectar a IA de novo.
AI_KEY_SECRET=
ASSISTANT_HOURLY_LIMIT=60
APP_TIMEZONE=America/Sao_Paulo
