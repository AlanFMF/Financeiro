{
  "appId": "io.github.alanfmf.saldo",
  "appName": "Saldo",
  "webDir": "dist",
  "android": {
    "backgroundColor": "#EDE6D6",
    "allowMixedContent": true
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DEFAULT"
    },
    "BackgroundRunner": {
      "label": "io.github.alanfmf.saldo.notificacoes",
      "src": "runners/notify.js",
      "event": "saldoCheck",
      "repeat": true,
      "interval": 30,
      "autoStart": true
    }
  }
}
